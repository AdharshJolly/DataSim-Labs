# ─── Database ────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=datasim_lab

# ─── App / CORS ───────────────────────────────────────────────
# development | staging | production
APP_ENV=development
# JSON array string. Include your frontend origin(s).
CORS_ORIGINS=["http://localhost:3000"]

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Cookie-based auth settings
AUTH_ACCESS_COOKIE_NAME=datasim_access_token
AUTH_REFRESH_COOKIE_NAME=datasim_refresh_token
AUTH_COOKIE_PATH=/
# Leave empty unless you need shared cookies across subdomains.
AUTH_COOKIE_DOMAIN=
# Set true in production.
AUTH_COOKIE_SECURE=false
# Use "none" for cross-site frontend/backend deployments, otherwise "lax".
AUTH_COOKIE_SAMESITE=lax

# ─── Gemini Realism Engine ───────────────────────────────────
# Get your key at https://aistudio.google.com/apikey
# Leave empty to disable automatic realism rules (dataset generation still works).
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Generation Safety Limits ────────────────────────────────
# Sync generation safety rails. Large requests should use /generate-async.
GENERATION_SYNC_ROW_LIMIT=50000
GENERATION_SYNC_CELL_LIMIT=1000000
GENERATION_ESTIMATED_OUTPUT_MB_LIMIT=512

# ─── Async Generation / Celery / Redis ───────────────────────
# Enable async worker paths and queue-backed generation.
ASYNC_GENERATION_ENABLED=false

# Redis broker/backend. Required when ASYNC_GENERATION_ENABLED=true.
# For Upstash, use rediss:// URLs.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Upstash-safe Celery tuning (command-volume controls):
# CELERY_REDIS_POLLING_INTERVAL_SECONDS: min=1, max=300
# CELERY_REDIS_VISIBILITY_TIMEOUT_SECONDS: min=60, max=86400
# CELERY_BROKER_CONNECTION_MAX_RETRIES: min=0, max=100
CELERY_REDIS_POLLING_INTERVAL_SECONDS=15
CELERY_REDIS_VISIBILITY_TIMEOUT_SECONDS=3600
CELERY_BROKER_CONNECTION_MAX_RETRIES=5

# If true, the service manager keeps web alive and disables only the worker
# when Upstash returns "max requests limit exceeded".
WORKER_AUTO_DISABLE_ON_UPSTASH_LIMIT=true

# Runtime status marker file name used by /health to report worker degradation.
# Only file name is accepted (directory segments are ignored for safety).
WORKER_HEALTH_STATE_FILE=.worker-health.json
